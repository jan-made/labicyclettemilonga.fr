{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "assignees": ["trejjam"],
  "rangeStrategy": "bump",
  "gitIgnoredAuthors": ["lint-action@samuelmeuli.com"],
  "packageRules": [
    {
      "groupName": "tailwind dependencies",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*"]
    },
    {
      "groupName": "next dependencies",
      "matchPackageNames": ["next", "eslint-config-next"]
    },
    {
      "groupName": "react dependencies",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    }
  ]
}
